{
  "name": "repoville",
  "version": "0.13.0",
  "description": "See your repo as a city: folders become districts, files become buildings, git history leaves its marks. One HTML file, plus Minecraft schematic and world exports.",
  "type": "module",
  "bin": {
    "repoville": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures": "node scripts/make-fixtures.mjs"
  },
  "keywords": [
    "minecraft",
    "code-visualization",
    "git",
    "visualization",
    "cli",
    "schematic",
    "litematic",
    "voxel",
    "technical-debt"
  ],
  "author": "Maxi (https://github.com/maximilianfeix)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maximilianfeix/repoville.git"
  },
  "homepage": "https://maximilianfeix.github.io/repoville/",
  "bugs": "https://github.com/maximilianfeix/repoville/issues",
  "devDependencies": {
    "@types/d3-hierarchy": "3.1.7",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "commander": "15.0.0",
    "d3-hierarchy": "3.1.2",
    "fast-check": "4.10.2",
    "fflate": "0.8.3",
    "ignore": "7.0.12",
    "playwright": "1.63.0",
    "prismarine-nbt": "2.8.0",
    "three": "0.186.1",
    "tinyexec": "1.3.1",
    "tinyglobby": "0.2.17",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "4.1.12"
  }
}
